# Kopieren nach .env und ausfüllen. .env wird NIE committet.

# Telegram: Bot über @BotFather anlegen, Chat-ID über @userinfobot holen,
# dem eigenen Bot einmal /start schreiben.
TELEGRAM_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Anthropic API-Key (platform.claude.com). Leer lassen = Bot läuft ohne KI.
ANTHROPIC_API_KEY=

# Optional: ntfy.sh-Topic als zweiter Benachrichtigungskanal
NTFY_TOPIC=
