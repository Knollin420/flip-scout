# Kopieren nach .env und ausfüllen. .env wird NIE committet (chmod 600).

# Telegram: Bot über @BotFather anlegen, Chat-ID über @userinfobot holen,
# dem eigenen Bot einmal /start schreiben.
TELEGRAM_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Anthropic API-Key (platform.claude.com). Leer lassen = Bot läuft ohne KI.
ANTHROPIC_API_KEY=

# Optional, nur für automatische willhaben-Nachrichten: der komplette "cookie"-Header
# aus dem Browser, während man bei willhaben angemeldet ist (siehe deploy/server/INSTALL.md).
WILLHABEN_COOKIE=
